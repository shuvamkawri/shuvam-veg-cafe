# Template only: don't put your key here. Copy this file to .env and add the key there.
GEMINI_API_KEY=

# Optional: change the Gemini model the bot uses.
GEMINI_MODEL=gemini-3.5-flash

# MongoDB connection string for bills (MongoDB Atlas > Connect > Drivers).
MONGODB_URI=
